{
  "name": "@turbo-agent/copilotkit-vue2-core",
  "private": false,
  "homepage": "https://github.com/Sherler/CopilotKit",
  "repository": {
    "type": "git",
    "url": "https://github.com/Sherler/CopilotKit.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "version": "1.9.3",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "types": "./dist/index.d.ts",
  "license": "MIT",
  "scripts": {
    "build": "tsup --clean",
    "dev": "tsup --watch",
    "test": "jest",
    "check-types": "tsc --noEmit",
    "clean": "rm -rf .turbo && rm -rf node_modules && rm -rf dist && rm -rf .next",
    "link:global": "pnpm link --global",
    "unlink:global": "pnpm unlink --global"
  },
  "peerDependencies": {
    "vue": "^2.6.0 || ^2.7.0"
  },
  "devDependencies": {
    "@vue/test-utils": "^1.3.6",
    "@types/jest": "^29.5.4",
    "eslint": "^8.56.0",
    "eslint-config-custom": "1.4.6",
    "jest": "^29.6.4",
    "jest-environment-jsdom": "^30.0.2",
    "vue": "^2.7.16",
    "vue-template-compiler": "^2.7.16",
    "ts-jest": "^29.1.1",
    "tsconfig": "1.4.6",
    "tsup": "^6.7.0",
    "typescript": "^5.2.3"
  },
  "dependencies": {
    "@turbo-agent/copilotkit-runtime-client-gql": "1.9.4",
    "@turbo-agent/copilotkit-shared": "1.9.4",
    "@scarf/scarf": "^1.3.0",
    "untruncate-json": "^0.0.1"
  },
  "keywords": [
    "copilotkit",
    "copilot",
    "vue",
    "vue2",
    "nodejs",
    "ai",
    "assistant",
    "javascript",
    "automation",
    "textarea"
  ]
}
