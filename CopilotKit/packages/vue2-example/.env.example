# CopilotKit Configuration
# Copy this file to .env.local and configure your values

# Base path for API requests (usually empty for relative paths)
VUE_APP_BASE_PATH=

# Default runtime URL (will be overridden by agent selection)
VUE_APP_COPILOT_RUNTIME_URL=http://localhost:3000

# Default agent name
VUE_APP_COPILOT_AGENT=common_agent

# Public API Key for CopilotKit Cloud (optional, alternative to runtimeUrl)
# VUE_APP_COPILOT_PUBLIC_API_KEY=your-public-api-key-here

# Note: assistant_id, user_id, and Authorization are typically passed via URL parameters:
# Example: http://localhost:8081?assistant_id=123&user_id=456&Authorization=token
